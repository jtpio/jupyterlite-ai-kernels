{
    "name": "jupyterlite-ai-kernels",
    "version": "0.1.1",
    "description": "AI kernels for JupyterLite",
    "keywords": [
        "jupyter",
        "jupyterlab",
        "jupyterlab-extension",
        "jupyterlite",
        "ai"
    ],
    "homepage": "https://github.com/jtpio/jupyterlite-ai-kernels",
    "bugs": {
        "url": "https://github.com/jtpio/jupyterlite-ai-kernels/issues"
    },
    "license": "BSD-3-Clause",
    "author": "JupyterLite Contributors",
    "files": [
        "lib/**/*.{d.ts,eot,gif,html,jpg,js,js.map,json,png,svg,woff2,ttf}",
        "style/**/*.{css,js,eot,gif,html,jpg,json,png,svg,woff2,ttf}",
        "src/**/*.{ts,tsx}"
    ],
    "main": "lib/index.js",
    "types": "lib/index.d.ts",
    "style": "style/index.css",
    "repository": {
        "type": "git",
        "url": "https://github.com/jtpio/jupyterlite-ai-kernels.git"
    },
    "scripts": {
        "build": "pnpm run build:lib && pnpm run build:labextension:dev",
        "build:prod": "pnpm run clean && pnpm run build:lib:prod && pnpm run build:labextension",
        "build:labextension": "jupyter-builder build .",
        "build:labextension:dev": "jupyter-builder build --development True .",
        "build:lib": "tsc --sourceMap",
        "build:lib:prod": "tsc",
        "clean": "pnpm run clean:lib",
        "clean:lib": "rimraf lib tsconfig.tsbuildinfo",
        "clean:lintcache": "rimraf .eslintcache .stylelintcache",
        "clean:labextension": "rimraf jupyterlite_ai_kernels/labextension jupyterlite_ai_kernels/_version.py",
        "clean:all": "pnpm run clean:lib && pnpm run clean:labextension && pnpm run clean:lintcache",
        "eslint": "pnpm run eslint:check --fix",
        "eslint:check": "eslint . --cache",
        "install:extension": "pnpm run build",
        "lint": "pnpm run stylelint && pnpm run prettier && pnpm run eslint",
        "lint:check": "pnpm run stylelint:check && pnpm run prettier:check && pnpm run eslint:check",
        "prettier": "pnpm run prettier:base --write --list-different",
        "prettier:base": "prettier \"**/*{.ts,.tsx,.js,.jsx,.css,.json,.md}\"",
        "prettier:check": "pnpm run prettier:base --check",
        "stylelint": "pnpm run stylelint:check --fix",
        "stylelint:check": "stylelint --cache \"style/**/*.css\"",
        "watch": "run-p watch:src watch:labextension",
        "watch:src": "tsc -w --sourceMap",
        "watch:labextension": "jupyter-builder watch ."
    },
    "dependencies": {
        "@jupyterlab/application": "^4.6.4",
        "@jupyterlab/nbformat": "^4.6.4",
        "@jupyterlab/rendermime": "^4.6.4",
        "@jupyterlab/services": "^7.6.4",
        "@jupyterlab/translation": "^4.6.4",
        "@jupyterlite/services": "^0.8.6",
        "@jupyternaut/agent": "^0.20.1",
        "jupyter-chat-components": "^0.6.0"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@jupyter/builder": "^1.2.3",
        "@jupyter/eslint-plugin": "^1.3.0",
        "@jupyterlab/core-meta": "^4.6.4",
        "@lumino/coreutils": "^2.2.3",
        "@module-federation/runtime-tools": "^2.9.2",
        "@types/json-schema": "^7.0.15",
        "@types/react": "^18.3.31",
        "@types/react-addons-linked-state-mixin": "^0.14.27",
        "css-loader": "^7.1.5",
        "eslint": "^10.12.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-prettier": "^5.5.6",
        "globals": "^17.13.0",
        "npm-run-all2": "^9.0.3",
        "prettier": "^3.9.9",
        "rimraf": "^6.1.3",
        "style-loader": "^4.0.0",
        "stylelint": "^17.16.0",
        "stylelint-config-recommended": "^18.0.0",
        "stylelint-config-standard": "^40.0.0",
        "stylelint-csstree-validator": "^4.0.0",
        "stylelint-prettier": "^5.0.3",
        "typescript": "~6.0.3",
        "typescript-eslint": "^8.71.1",
        "yjs": "^13.6.33"
    },
    "sideEffects": [
        "style/*.css",
        "style/index.js"
    ],
    "styleModule": "style/index.js",
    "publishConfig": {
        "access": "public"
    },
    "jupyterlab": {
        "extension": true,
        "outputDir": "jupyterlite_ai_kernels/labextension",
        "sharedPackages": {
            "@jupyterlab/rendermime": {
                "bundled": false,
                "singleton": true
            },
            "@jupyterlite/services": {
                "bundled": false,
                "singleton": true
            },
            "@jupyternaut/agent": {
                "bundled": false,
                "singleton": true
            },
            "@lumino/coreutils": {
                "bundled": false,
                "singleton": true
            }
        }
    },
    "prettier": {
        "singleQuote": true,
        "trailingComma": "none",
        "arrowParens": "avoid",
        "endOfLine": "auto",
        "overrides": [
            {
                "files": "package.json",
                "options": {
                    "tabWidth": 4
                }
            }
        ]
    },
    "stylelint": {
        "extends": [
            "stylelint-config-recommended",
            "stylelint-config-standard",
            "stylelint-prettier/recommended"
        ],
        "plugins": [
            "stylelint-csstree-validator"
        ],
        "rules": {
            "csstree/validator": true,
            "property-no-vendor-prefix": null,
            "selector-class-pattern": "^([a-z][A-z\\d]*)(-[A-z\\d]+)*$",
            "selector-no-vendor-prefix": null,
            "value-no-vendor-prefix": null
        }
    }
}
